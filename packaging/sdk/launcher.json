{
  "schema_version": 1,
  "name": "launcher",
  "description": "Headers and libraries required by LILYGO UI Launcher and AppKit",
  "development_packages": [
    "libdrm-dev",
    "libfreetype6-dev",
    "libbrotli-dev",
    "libbz2-dev",
    "libpng-dev",
    "libpam0g",
    "libasound2-dev"
  ],
  "export_paths": [
    "lib/aarch64-linux-gnu",
    "lib/ld-linux-aarch64.so.1",
    "usr/include",
    "usr/lib/linux",
    "usr/lib/aarch64-linux-gnu",
    "usr/lib/gcc/aarch64-linux-gnu",
    "usr/lib/pkgconfig",
    "usr/local/include",
    "usr/local/lib",
    "usr/share/pkgconfig",
    "etc/ld.so.conf",
    "etc/ld.so.conf.d",
    "etc/os-release",
    "var/lib/dpkg/status"
  ],
  "required_paths": [
    "usr/include/stdio.h",
    "usr/include/aarch64-linux-gnu/bits/libc-header-start.h",
    "usr/lib/linux/uapi/arm64/asm/errno.h",
    "usr/lib/linux/uapi/arm64/asm/types.h",
    "usr/include/xf86drm.h",
    "usr/include/libdrm/drm.h",
    "usr/include/freetype2/ft2build.h",
    "usr/include/brotli/decode.h",
    "usr/include/bzlib.h",
    "usr/include/png.h",
    "usr/include/alsa/asoundlib.h",
    "lib/ld-linux-aarch64.so.1",
    "usr/lib/aarch64-linux-gnu/crt1.o",
    "usr/lib/aarch64-linux-gnu/libc.so",
    "usr/lib/aarch64-linux-gnu/libdrm.so",
    "usr/lib/aarch64-linux-gnu/libfreetype.so",
    "usr/lib/aarch64-linux-gnu/libbrotlidec.so",
    "usr/lib/aarch64-linux-gnu/libbrotlicommon.so",
    "usr/lib/aarch64-linux-gnu/libbz2.so",
    "usr/lib/aarch64-linux-gnu/libpng.so",
    "usr/lib/aarch64-linux-gnu/libpam.so.0",
    "usr/lib/aarch64-linux-gnu/libasound.so",
    "usr/lib/aarch64-linux-gnu/pkgconfig/libdrm.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/freetype2.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/libbrotlidec.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/libbrotlicommon.pc",
