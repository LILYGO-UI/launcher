[Unit]
Description=LILYGO UI Launcher
After=systemd-udev-settle.service network-online.target time-sync.target
Wants=network-online.target time-sync.target
Wants=systemd-udev-settle.service
Conflicts=getty@tty1.service display-manager.service cm0-launcher.service

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=lilygo-ui-launcher
ExecStartPre=/usr/lib/lilygo-ui-launcher/lilygo-ui-launcher-console acquire
ExecStart=/usr/bin/lilygo-ui-launcher --display drm --drm /dev/dri/card0 --input /dev/input/by-path/platform-3f205000.i2c-event
ExecStopPost=/usr/lib/lilygo-ui-launcher/lilygo-ui-launcher-console release
Restart=on-failure
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
